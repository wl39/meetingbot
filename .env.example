# Copy to .env; never commit credentials. Read by backend and prepare_models.py.
HF_TOKEN=
PYANNOTE_METRICS_ENABLED=0
STT_ENGINE=real
STT_MAX_FILE_SECONDS=18000
STT_MAX_FILE_BYTES=4294967296
# File ASR central window (seconds), with 2 seconds of context on each side.
STT_FILE_CHUNK_SECONDS=120
# Auto: NVIDIA CUDA, Apple MPS, then CPU. 0 threads selects half the logical cores (max 8).
STT_DIARIZATION_DEVICE=auto
STT_DIARIZATION_CPU_THREADS=0
STT_DIARIZATION_BATCH_SIZE=8
# STT_DATA_DIR=/absolute/path/to/meetingbot/.runtime
STT_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://127.0.0.1:8765"]
# Optional tailnet access via Tailscale Serve (keep uvicorn on loopback).
# STT_PUBLIC_ORIGIN=https://your-device.your-tailnet.ts.net
# STT_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver","100.x.y.z","your-device.your-tailnet.ts.net"]
# STT_REDIRECT_HOSTS=["100.x.y.z","your-device.your-tailnet.ts.net"]
# Add the exact HTTPS origin to STT_ORIGINS above; never use a wildcard.
# Same-origin meeting assistant bridge to the separate RAG service.
STT_RAG_BASE_URL=http://127.0.0.1:8766
# Defaults to STT's local-token; set this if RAG has a different administrator key.
# STT_RAG_TOKEN_FILE=/absolute/path/to/rag/admin-token
# Optional public RAG origin for the library/settings links (never include credentials).
# STT_RAG_PUBLIC_URL=https://your-device.your-tailnet.ts.net:8443

# Keyless visitor sessions; administrative operations still require an administrator key.
STT_KEYLESS_LOGIN=true
