RAG_DATA_DIR=./.rag-data
RAG_SOURCE_ROOTS_FILE=./config/source-roots.yaml
RAG_ACCESS_MODE=local
RAG_PUBLIC_ORIGIN=
# Optional canonical STT origin for the unified UI (HTTPS origin for remote access).
RAG_WORKSPACE_URL=http://127.0.0.1:8765
RAG_ALLOWED_HOSTS=["127.0.0.1","localhost"]
RAG_ORIGINS=["http://127.0.0.1:8766","http://localhost:8766"]
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
RAG_EMBEDDING_DEVICE=auto
RAG_EXTERNAL_LLM_ALLOWED=false
RAG_CLIPROXY_BASE_URL=http://127.0.0.1:8317/v1
RAG_CLIPROXY_API_KEY=
RAG_LLM_RESPONSE_MODEL=
LANGSMITH_TRACING=false

# Optional managed local CLIProxyAPI installation (scripts/cliproxy.py install)
# RAG_MANAGED_PROXY_DIR="/Users/you/Library/Application Support/MeetingbotCLIProxy"
# Web model settings override the initial LLM defaults above and survive restart.

# Folder uploads: source copies + reserved incoming bytes (index/backup size separate)
RAG_UPLOAD_STORAGE_BYTES=1073741824
RAG_UPLOAD_SESSION_HOURS=24

# Keyless visitor sessions; administrative operations still require an administrator key.
RAG_KEYLESS_LOGIN=true
